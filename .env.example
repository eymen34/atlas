# Atlas — local development environment.
#
# Copy this file to .env at repo root and tweak as needed:
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real credentials. Keep this template
# in sync with the variables consumed by deploy/docker-compose.yml and
# the Spring Boot app.

# ── DATABASE ──────────────────────────────────────────────────────────
# Consumed by the `db` (postgres:17-alpine) service.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_secret

# APP_DATABASE_* are read by the Spring Boot app via relaxed binding to
# app.database.* (DataSourceConfig from T-002). APP_DATABASE_URL uses
# the docker-compose service name 'db'. To run the app directly on the
# host machine (outside Docker), change 'db' to 'localhost'.
APP_DATABASE_URL=jdbc:postgresql://db:5432/atlas
APP_DATABASE_USERNAME=atlas
APP_DATABASE_PASSWORD=atlas_secret

# HikariCP pool sizing. DataSourceConfig reads these directly via
# System.getenv() (not Spring relaxed binding). Defaults: max=10, min=2.
DB_POOL_MAX=10
DB_POOL_MIN=2

# The AppCDS-only DB startup-check toggle is intentionally NOT listed
# here. It defaults to true (the only supported value for any
# deployment) and is only overridden inside stage 3 of /Dockerfile to
# allow the AppCDS image-build to boot without a reachable database.
# Setting it false anywhere else silently disables the fail-fast DB
# ping. See io.ngss.atlas.config.DatabaseStartupValidator javadoc.

# ── OBJECT STORAGE ────────────────────────────────────────────────────
# MINIO_ROOT_* are consumed by the `objectstore` (MinIO) container and
# by `mc-init` to authenticate the bootstrap session. Production uses
# real S3/R2/Spaces and ignores these.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# OBJECT_STORAGE_ENDPOINT: the address the backend uses for AWS SDK
# calls. Inside the Docker network this is the `objectstore` service
# name. In production this is the real S3 endpoint.
OBJECT_STORAGE_ENDPOINT=http://objectstore:9000

# OBJECT_STORAGE_PUBLIC_ENDPOINT: hostname embedded in presigned URLs
# returned to the browser. Must be resolvable from the client host —
# so for local dev this is `localhost`, not `objectstore` (which only
# resolves inside the Docker network). In production ENDPOINT and
# PUBLIC_ENDPOINT typically point to the same S3 hostname.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=atlas-uploads

# In production use a least-privilege IAM / service-account credential
# scoped to this bucket — NOT the MinIO root credential, NOT a long-lived
# AWS root key. Rotation is the operator's responsibility.
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin123

# ── AUTH ──────────────────────────────────────────────────────────────
# Spring Security / JWT scaffolding lands in T-009; these vars are
# forward-looking placeholders so the dev .env stays stable across
# tickets. JWT_SECRET MUST be ≥ 32 chars in any non-dev environment
# and MUST come from a secrets manager.
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# Frontend (Vite) mirror of the access-token lifetime, used only as a fallback
# to derive client-side expiry when a refresh response omits an absolute
# timestamp (T-013). Frontend env MUST use the VITE_ prefix — never APP_.
VITE_ACCESS_TTL_SECONDS=900

# Poll interval (ms) for the in-app notification bell — both the unread-count
# badge and the open dropdown list refetch on this cadence (T-024). Defaults to
# 30000 (30s) if unset, blank, or non-positive.
VITE_NOTIFICATION_POLL_INTERVAL_MS=30000

# ── SMTP ──────────────────────────────────────────────────────────────
# Point at a local MailHog / MailCatcher in dev (default port 1025);
# in production set SMTP_STARTTLS=true and supply real credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=false

# ── OUTBOX ────────────────────────────────────────────────────────────
# Shared secret the external cron job sends as the X-Drain-Secret
# header when calling POST /internal/tasks/drain-outbox every 60s.
# Rotate by changing this value AND the cron job's secret together.
OUTBOX_DRAIN_SHARED_SECRET=change-me-outbox-secret

# ── BASE URL ──────────────────────────────────────────────────────────
# Absolute URLs in outgoing email templates (and anywhere else the app
# needs to render a link back to itself).
APP_BASE_URL=http://localhost:8080

# ── FEATURE FLAGS ─────────────────────────────────────────────────────
# Per-feature toggles for experimental work. All default true in dev.
FEATURE_WATCHERS_ENABLED=true
