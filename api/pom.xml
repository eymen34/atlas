<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.6</version>
    <relativePath/>
  </parent>

  <groupId>io.ngss.atlas</groupId>
  <artifactId>atlas-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>atlas-api</name>
  <description>Atlas REST API (Spring Boot 4, Java 21)</description>

  <properties>
    <java.version>21</java.version>
    <!-- ArchUnit 1.4.x bundles ASM 9.8+ which can parse class file major
         version 70 (Java 26). 1.3.x ships an older ASM that throws
         IllegalArgumentException on Java 26 bytecode during rule import. -->
    <archunit.version>1.4.1</archunit.version>
    <spotless.version>2.43.0</spotless.version>
    <testcontainers.version>1.21.3</testcontainers.version>
    <rest-assured.version>5.5.2</rest-assured.version>
    <!-- Override Spring Boot 4 parent BOM's Groovy 5 with Groovy 4. REST Assured
         5.5.x is compiled against Groovy 4 and its JsonPath / Hamcrest body
         assertion path NPEs on Groovy 5. The override applies project-wide
         via dependencyManagement in the Boot parent. -->
    <groovy.version>4.0.32</groovy.version>
    <!-- Override Spring Boot 4 parent BOM Flyway version. Locked to 10.20.x
         per architecture_decisions:migration_tool. -->
    <flyway.version>10.20.1</flyway.version>
    <!-- logstash-logback-encoder 8.x supports SLF4J 2.x + Logback 1.5.x
         (the versions Spring Boot 4.0.6 manages). -->
    <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- T-009: Spring Security 6 (Boot 4 BOM-managed) + Nimbus JOSE for
         HS256 JWT verification in JwtAuthenticationFilter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- spring-boot-starter-flyway pulls in the Boot-4 Flyway autoconfig
         (spring-boot-flyway module) which actually creates the Flyway bean,
         reads spring.flyway.* properties, and runs migrate() on startup.
         flyway-core alone (the library) does nothing without this glue —
         Spring Boot 4 split the autoconfig out of spring-boot-autoconfigure
         into its own module, so the starter is now mandatory. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- flyway-database-postgresql is the dialect plugin; the starter only
         depends on flyway-core. flyway.version is locked to 10.20.1 via the
         <properties> override; the starter inherits that. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-logback-encoder.version}</version>
    </dependency>

    <!-- springdoc-openapi targets Spring Boot 3.x. Pinned 2.6.0 per
         architecture_decisions:api_style. T-009 verifies it boots on
         Boot 4.0.6 / Spring Framework 7.0.7 before any further work. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test scope -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <!--
          AOT bean-definition generation is OPT-IN via the `aot` profile
          below (see the <profiles> section at the bottom of this POM).

          History: T-006 originally bound process-aot to prepare-package
          so `mvn package` produced an AOT-warmed fat jar for the
          Dockerfile stage 2 build. T-009 added springdoc-openapi 2.6.0,
          which transitively triggers a Boot-4 incompatibility during
          AOT introspection:

            springdoc 2.6.0's `QuerydslPredicateOperationCustomizer`
            references `org.springframework.data.util.TypeInformation`
            (Spring Data 3.x location). Spring Data 4.0.5 — the version
            shipped with Boot 4.0.6 — moved the class to
            `org.springframework.data.core.TypeInformation`. AOT
            introspects every potentially-registered bean (including
            those guarded by @ConditionalOnClass(Querydsl…)) and a
            reflective `Class.getDeclaredMethods()` on the customizer
            raises NoClassDefFoundError on the now-absent `util` symbol.

          Runtime is unaffected because the Querydsl-gated bean is never
          instantiated (no Querydsl on the classpath). Only AOT-time
          introspection trips the missing symbol.

          Re-enable the default binding when springdoc ships a Boot-4
          compatible release that updates the TypeInformation import.
        -->
      </plugin>

      <!--
        Spotless replaceRegex bans @Scheduled, @EnableScheduling, and
        ScheduledExecutorService in /api production sources.

        IMPORTANT: These steps are CHECK-ONLY by convention. Do NOT run
        `mvn spotless:apply` — it would rewrite banned tokens in place and
        defeat the guard. Always use `mvn spotless:check` (which runs in
        the verify phase via the execution below). The architectural
        decision being enforced is `realtime` (HTTP polling only).

        Scope is src/main/java/** only so that test files referencing the
        banned tokens (e.g. NoSchedulingArchTest) do not trip the guard.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
            </includes>
            <replaceRegex>
              <name>ban-scheduled-annotation</name>
              <searchRegex>@Scheduled\b</searchRegex>
              <replacement>@Scheduled_SPOTLESS_VIOLATION_NO_SCHEDULING</replacement>
            </replaceRegex>
            <replaceRegex>
              <name>ban-enable-scheduling</name>
              <searchRegex>@EnableScheduling\b</searchRegex>
              <replacement>@EnableScheduling_SPOTLESS_VIOLATION_NO_SCHEDULING</replacement>
            </replaceRegex>
            <replaceRegex>
              <name>ban-scheduled-executor-service</name>
              <searchRegex>ScheduledExecutorService\b</searchRegex>
              <replacement>ScheduledExecutorService_SPOTLESS_VIOLATION_NO_SCHEDULING</replacement>
            </replaceRegex>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Opt-in AOT processing. Activate with `mvn -P aot …` to exercise
      the same prepare-package binding T-006 originally added. Kept as a
      live regression check so we know the day springdoc + Boot 4 + AOT
      can co-exist again (see the comment block in the spring-boot-
      maven-plugin <executions> section above for the full context).

      Build the Dockerfile WITHOUT this profile until further notice:
      stage 2's `mvn package` works without AOT artifacts, and stage 3's
      AppCDS warm-up does NOT depend on AOT — it simply class-loads the
      jar under -Dspring.context.exit=onRefresh and archives the loaded
      classes. Cold-start loses the ~100–200 ms AOT bean-definition
      win; the AppCDS ~200–400 ms win is unaffected.
    -->
    <profile>
      <id>aot</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>process-aot</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      T-010 build-time OpenAPI spec dump. Active by default so a plain
      `mvn -pl api verify` regenerates src/main/resources/openapi/openapi.json
      and the CI drift-check stays meaningful. Maven disables an
      activeByDefault profile whenever ANY profile is selected explicitly
      (e.g. `-P aot`), so AOT runs never boot the app for a spec dump.

      Mechanism — RUNTIME boot, never AOT (see the
      springdoc_boot4_aot_incompatibility decision; process-aot stays in the
      `aot` profile above):

        pre-integration-test   spring-boot:start boots the app under the
                               `specgen` Spring profile. No database is needed:
                               Flyway and the DatabaseStartupValidator ping are
                               switched off in application-specgen.properties,
                               and the base application.yml already supplies the
                               no-JDBC Hibernate cold-start config.
        integration-test       springdoc:generate GETs /v3/api-docs and writes
                               ${project.build.directory}/openapi.json. The
                               `specgen` profile turns on springdoc key-sorting +
                               pretty-printing so the dump is canonical and
                               byte-stable across machines — no external `jq`.
        post-integration-test  spring-boot:stop.
        verify                 antrun copies the dumped spec over the committed
                               src/main/resources/openapi/openapi.json.

      H2 is deliberately NOT added: the custom DataSourceConfig ignores
      spring.datasource.* and DatabaseProperties.url is regex-locked to a
      Postgres JDBC URL, so H2 cannot back this app — and it is not needed,
      because nothing opens a connection during the dump.
    -->
    <profile>
      <id>specgen-build</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>spec-dump-start</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>start</goal>
                </goals>
                <configuration>
                  <profiles>
                    <profile>specgen</profile>
                  </profiles>
                  <!-- Surface a hung start fast: poll every 1s, give up at 120. -->
                  <wait>1000</wait>
                  <maxAttempts>120</maxAttempts>
                </configuration>
              </execution>
              <execution>
                <id>spec-dump-stop</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-maven-plugin</artifactId>
            <version>1.4</version>
            <executions>
              <execution>
                <id>dump-spec</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <apiDocsUrl>http://localhost:8080/v3/api-docs</apiDocsUrl>
              <outputFileName>openapi.json</outputFileName>
              <outputDir>${project.build.directory}</outputDir>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-openapi-spec</id>
                <phase>verify</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.basedir}/src/main/resources/openapi"/>
                    <copy
                        file="${project.build.directory}/openapi.json"
                        tofile="${project.basedir}/src/main/resources/openapi/openapi.json"
                        overwrite="true"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
