# ----------------------------------------------------------------------------
# Root .gitignore — Sprint 0 skeleton
# Sections: Maven/Java, Node, Environment/secrets, OS, IDE
# ----------------------------------------------------------------------------

# Maven / Java
target/
*.jsa
*.class

# Node
node_modules/
dist/
coverage/
playwright-report/
playwright/.cache/
test-results/

# Generated API client (regenerated by frontend build from OpenAPI spec)
web/src/api/generated/

# Build-time derived copy of the canonical OpenAPI spec, staged in web-root so
# the Vite/Docker web-build stage is self-contained. Canonical source is
# api/src/main/resources/openapi/openapi.json; this copy is produced by
# web/scripts/copy-spec.mjs and must never be committed.
web/openapi.json

# TypeScript incremental build artifacts
*.tsbuildinfo

# Stray create-next-app scaffold, not part of the project. The real frontend
# lives in web/. Ignored so it never gets committed by accident.
atlas-web/

# Environment / secrets
# Do NOT commit .env.example with real credentials — placeholders/comments only.
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# IDE / tooling
.idea/
.vscode/
.claude/
*.iml
.project
.classpath
.settings/
