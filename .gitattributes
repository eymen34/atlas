# Enforce LF endings on text files cross-platform so Spotless and the
# .editorconfig agree on Windows checkouts (where core.autocrlf=true
# would otherwise convert to CRLF on checkout).

* text=auto eol=lf

# Explicit text-with-LF for files that must be LF on every platform.
*.java text eol=lf
*.kt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
CODEOWNERS text eol=lf
LICENSE text eol=lf
mvnw text eol=lf

# Windows batch files must be CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.jar binary
*.jsa binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
